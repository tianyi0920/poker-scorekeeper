{
  "name": "poker-scorekeeper",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm build && playwright test",
    "avatars:generate": "node scripts/generate-preset-avatars.mjs",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "lint": "pnpm -r lint",
    "pretypecheck": "pnpm --filter @poker/contracts build && pnpm --filter @poker/settlement build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @poker/api dev",
    "dev:web": "pnpm --filter @poker/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.55.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "mariadb": "^3.4.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
