PORT=80
DEPLOYMENT_ID=replace_with_git_revision_or_release_id
PUBLIC_ORIGIN=http://pk.tianyi.wiki
# Optional comma-separated exact origins for additional trusted browser entry points.
WS_ALLOWED_ORIGINS=
DATABASE_URL=mysql://poker_user:replace_me@192.168.10.248:3306/poker_scorekeeper
# Remote test endpoint reference only; never point production at this value.
TEST_DATABASE_URL=mysql://poker_test_user:replace_me@tianyi.wiki:8306/poker_scorekeeper_test
SESSION_SECRET=replace_with_at_least_32_random_bytes
CSRF_SECRET=replace_with_at_least_32_random_bytes
BOOTSTRAP_ADMIN_USERNAME=rootadmin
BOOTSTRAP_ADMIN_NICKNAME=初始管理员
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_strong_password
READINESS_TIMEOUT_MS=2000

# Backup jobs reuse container environment so passwords never appear in command arguments.
MYSQL_HOST=192.168.10.248
MYSQL_PORT=3306
MYSQL_USER=poker_backup_user
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=poker_scorekeeper
BACKUP_DIR=/data/backups
AVATAR_ROOT=/data/avatars
